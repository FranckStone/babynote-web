{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babynote",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "routes": [
    {
      "pattern": "babynote.baby",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babynote",
      "database_id": "ccb7f77a-8b90-4343-a4c4-608487b0e286"
    }
  ],
  "observability": {
    "enabled": true
  }
}
